APP_NAME="Observatoire des ABC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL + PostGIS (dev : conteneur Docker, port 5433) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=abc
DB_USERNAME=abc
DB_PASSWORD=abc

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Inertia SSR (rendu serveur pour le SEO) ---
# Local dev : false (aucun serveur SSR lancé par défaut).
# Production : true + le watchdog `ssr:watchdog` (cron) maintient le serveur en vie, après `npm run build`.
INERTIA_SSR_ENABLED=false
# Binaire Node utilisé par le watchdog (chemin absolu recommandé, ex. Plesk : /opt/plesk/node/24/bin/node).
SSR_NODE_BIN=node

# --- Mesure d'audience (consentement RGPD) ---
# Laissez vide pour désactiver (rien n'est chargé sans consentement).
# MATOMO_URL=https://stats.votre-domaine.fr
# MATOMO_SITE_ID=1
# GTAG_ID=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Collect mensuel automatique ---
# La synchronisation (upserts + suppression ciblée) n'exige AUCUN superuser.
COLLECT_AUTOMATIC=false

# --- Sources data.gouv ---
# true (défaut) : les URLs CSV sont re-résolues à chaque collect via l'API
# data.gouv pour suivre la dernière révision (repli sur l'URL pinnée).
SOURCES_AUTO_RESOLVE=true

# --- Sauvegardes ---
# Commande de copie distante exécutée après chaque abc:backup.
# Un dump resté sur le même disque que la base n'est pas une sauvegarde.
# Exemples : "rclone copy {file} remote:observatoire-abc" ou
#            "scp {file} backup@nas:/srv/backups/"
BACKUP_UPLOAD_CMD=

# --- Compte administrateur (seedé via db:seed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Reverse proxy & cookies ---
# TRUST_PROXY=1 : derrière nginx/Plesk, request()->ip() lit l'IP réelle
# (X-Forwarded-For) et le schéma https est respecté.
# COOKIE_SECURE=1 : cookie de session en Secure (HTTPS uniquement).
# Les deux à 0 en local direct (artisan serve / conteneur Docker).
TRUST_PROXY=0
COOKIE_SECURE=0

VITE_APP_NAME="${APP_NAME}"
