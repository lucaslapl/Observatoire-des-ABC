# Administration (un seul admin pour le moment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Derrière un reverse proxy (Plesk/nginx) : on lit l'IP via X-Forwarded-For
TRUST_PROXY=1

# Cookie de session en Secure (HTTPS) — activer en production
COOKIE_SECURE=1

# Port HTTP du serveur
PORT=4000
