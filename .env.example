APP_NAME="Observatoire des ABC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL + PostGIS (dev : conteneur Docker, port 5433) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=abc
DB_USERNAME=abc
DB_PASSWORD=abc

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Collect mensuel automatique (false en prod : exige un superuser Postgres) ---
COLLECT_AUTOMATIC=false

# --- Compte administrateur (seedé via db:seed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Ancien serveur Node (variables héritées, sans effet côté Laravel) ---
TRUST_PROXY=0
COOKIE_SECURE=0
PORT=4000

VITE_APP_NAME="${APP_NAME}"
