APP_NAME="Observatoire des ABC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL + PostGIS (dev : conteneur Docker, port 5433) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=abc
DB_USERNAME=abc
DB_PASSWORD=abc

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Inertia SSR (rendu serveur pour le SEO) ---
# Local dev : false (aucun serveur SSR lancé par défaut).
# Production : true + le watchdog `ssr:watchdog` (cron) maintient le serveur en vie, après `npm run build`.
INERTIA_SSR_ENABLED=false
# URL du serveur SSR. En production, utiliser un port DÉDIÉ (le défaut
# Inertia 13714 est partagé par toutes les apps du serveur : deux vhosts
# Inertia sur ce port se renvoient leurs rendus — « Page not found » croisés
# dans ssr.log). Le watchdog et le bundle SSR suivent ce port.
#INERTIA_SSR_URL=http://127.0.0.1:13814
# Binaire Node utilisé par le watchdog (chemin absolu recommandé, ex. Plesk : /opt/plesk/node/24/bin/node).
SSR_NODE_BIN=node

# --- Mesure d'audience Matomo (RGPD) ---
# Mesure anonyme exemptée de consentement : chargée par défaut, révocable
# via la bannière. Laissez vide pour désactiver.
# MATOMO_URL=https://stats.votre-domaine.fr
# MATOMO_SITE_ID=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Emails (SMTP) ---
# Local Docker : Mailpit (service `mailpit` du docker-compose, interface sur
# http://localhost:8025). Hors Docker : MAIL_MAILER=log pour écrire dans
# storage/logs/laravel.log.
# Production : SMTP réel (voir AGENTS.md), ex. :
#   MAIL_HOST=smtp.ouvaton.coop  MAIL_PORT=587  MAIL_USERNAME=...  MAIL_PASSWORD=...
#   MAIL_ENCRYPTION=tls
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="observatoire@abc.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Contact ---
# Destinataire des messages du formulaire /contact. Indépendant de
# MAIL_FROM_ADDRESS (qui reste l'expéditeur des emails du site).
CONTACT_EMAIL="contact@example.org"
# SMTP dédié au formulaire de contact : nécessaire si l'adresse de contact
# est sur un autre domaine avec ses propres identifiants. Si ces variables
# sont absentes, le SMTP par défaut (MAIL_*) est utilisé.
#CONTACT_MAIL_HOST=smtp.autre-domaine.fr
#CONTACT_MAIL_PORT=587
#CONTACT_MAIL_SCHEME=smtps
#CONTACT_MAIL_USERNAME=contact@autre-domaine.fr
#CONTACT_MAIL_PASSWORD=secret

# --- Collect mensuel automatique ---
# La synchronisation (upserts + suppression ciblée) n'exige AUCUN superuser.
COLLECT_AUTOMATIC=false

# --- Sources data.gouv ---
# true (défaut) : les URLs CSV sont re-résolues à chaque collect via l'API
# data.gouv pour suivre la dernière révision (repli sur l'URL pinnée).
SOURCES_AUTO_RESOLVE=true

# --- Sauvegardes ---
# Commande de copie distante exécutée après chaque abc:backup.
# Un dump resté sur le même disque que la base n'est pas une sauvegarde.
# Exemples : "rclone copy {file} remote:observatoire-abc" ou
#            "scp {file} backup@nas:/srv/backups/"
BACKUP_UPLOAD_CMD=

# --- Compte administrateur (seedé via db:seed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Reverse proxy & cookies ---
# TRUST_PROXY=1 : derrière nginx/Plesk, request()->ip() lit l'IP réelle
# (X-Forwarded-For) et le schéma https est respecté.
# COOKIE_SECURE=1 : cookie de session en Secure (HTTPS uniquement).
# Les deux à 0 en local direct (artisan serve / conteneur Docker).
TRUST_PROXY=0
COOKIE_SECURE=0

VITE_APP_NAME="${APP_NAME}"
