{
  "name": "observatoire-des-abc",
  "version": "0.2.0",
  "description": "Observatoire des Atlas de la Biodiversité Communale (ABC) en France",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "tsx src/cli.ts collect",
    "status": "tsx src/cli.ts status",
    "export:csv": "tsx src/cli.ts export --fmt csv",
    "export:geojson": "tsx src/cli.ts export --fmt geojson",
    "verify": "tsx src/cli.ts verify",
    "backup": "tsx src/cli.ts backup",
    "serve": "tsx server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "start:server": "bash scripts/start-server.sh",
    "stop:server": "bash scripts/stop-server.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
