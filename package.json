{
  "name": "observatoire-des-abc",
  "version": "0.1.0",
  "description": "Observatoire des Atlas de la Biodiversité Communale (ABC) en France",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "collect": "tsx src/cli.ts collect",
    "status": "tsx src/cli.ts status",
    "export:csv": "tsx src/cli.ts export --fmt csv",
    "export:geojson": "tsx src/cli.ts export --fmt geojson",
    "serve": "tsx server/index.ts",
    "start:server": "bash scripts/start-server.sh",
    "stop:server": "bash scripts/stop-server.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}